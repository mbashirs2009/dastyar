# ---------------------------------------------------------------------------
# تنظیمات بک‌اند «دستیار»
# هیچ کلیدی اجباری نیست — بدون .env هم اپ کار می‌کند (مدل رایگان Pollinations)
# این فایل را به .env کپی کنید اگر خواستید چیزها را شخصی‌سازی کنید.
# ---------------------------------------------------------------------------

# --- نوع سرویس ---
# auto          = اگر کلید OpenRouter بود از آن، وگرنه Pollinations (پیشنهادی)
# pollinations  = فقط مدل رایگان بدون کلید
# openrouter    = اول OpenRouter، اگر نشد Pollinations
# mock          = همیشه پاسخ نمایشی
LLM_PROVIDER=auto

# --- OpenRouter (اختیاری) ---
# کلید از https://openrouter.ai/keys — اگر بگذارید سرعت/کیفیت معمولاً بهتر می‌شود
# نکته: روی بعضی اینترنت‌های ایران OpenRouter فیلتر است؛ در آن صورت خودکار
# به Pollinations برمی‌گردیم.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# --- Pollinations (پیش‌فرض رایگان) ---
# بدون کلید کار می‌کند. مدل‌ها: openai | mistral | llama
POLLINATIONS_BASE_URL=https://text.pollinations.ai
POLLINATIONS_MODEL=openai

# --- JWT ---
# یک رشته تصادفی طولانی:
# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# --- OAuth گوگل (اختیاری) ---
# Redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth گیت‌هاب (اختیاری) ---
# Callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Telegram Mini App / Bot (اختیاری) ---
# ۱. در تلگرام به @BotFather برو → /newbot → توکن را اینجا بگذار
# ۲. TELEGRAM_WEBAPP_URL باید HTTPS باشد (localhost در تلگرام باز نمی‌شود)
#    برای تست: ngrok http 5173
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=

# --- سرور ---
APP_HOST=127.0.0.1
APP_PORT=8000
MOCK_MODE=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
